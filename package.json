{
  "name": "desitv",
  "version": "1.0.0",
  "description": "DesiTV™ - Nostalgic retro TV streaming platform recreating 2000s Indian television vibes",
  "author": "Swarnapudi Ishwar <swarnapudiishwar@gmail.com> (https://pudiish.github.io/pudi/)",
  "license": "MIT",
  "homepage": "https://github.com/pudiish/desiTV",
  "repository": {
    "type": "git",
    "url": "https://github.com/pudiish/desiTV.git"
  },
  "keywords": [
    "desitv",
    "retro-tv",
    "nostalgia",
    "2000s",
    "indian-tv",
    "9xm",
    "mern",
    "streaming"
  ],
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start": "node server/index.js",
    "build": "cd client && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node scripts/validate-ui.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "playwright": "^1.62.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "ogl": "^1.0.11"
  }
}
