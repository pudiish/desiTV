# ============================================
# DesiTV Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
VITE_CLIENT_PORT=5173

# ============================================
# CORS & CLIENT URL
# ============================================
# For production, set these to your Vercel URL
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ============================================
# AUTHENTICATION
# ============================================
# Generate a secure random string for JWT signing
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# FIREBASE (Client-side - safe to expose)
# ============================================
# These are public Firebase config values (safe for client)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# FIREBASE ADMIN (Server-side - SENSITIVE!)
# ============================================
# For production: Paste the entire Firebase service account JSON (minified)
# Get from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# ============================================
# API KEYS (SENSITIVE!)
# ============================================
# YouTube Data API v3 - for fetching video metadata
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# Google AI / Gemini API - for DesiAgent chatbot
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=your-google-ai-key-here

# ============================================
# CLIENT API BASE (for Vite)
# ============================================
# For production, set to your Render URL
VITE_API_BASE=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# ============================================
# OPTIONAL: Redis Cache
# ============================================
# REDIS_URL=redis://localhost:6379
# REDIS_HYBRID_MODE=true

# ============================================
# OPTIONAL: MongoDB (not needed for JSON setup)
# ============================================
# MONGO_URI=mongodb://localhost:27017/desitv
